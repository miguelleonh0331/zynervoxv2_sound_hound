#!/bin/bash
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
[[ $EUID -eq 0 ]] || { echo 'Usar sudo -n /usr/local/sbin/deploy-zynervoxv2' >&2; exit 1; }
mode=apply
case "$#:${1-}" in
  0:) ;;
  1:--dry-run) mode=preview ;;
  *) echo 'Solo se admite ejecutar sin argumentos o con --dry-run.' >&2; exit 2 ;;
esac
source_root=/opt/zynervoxv2-source-soundhound
destination=/var/www/html/zynervoxv2
[[ "$(hostname)" = SrvPredic ]]
[[ "$(readlink -f "$source_root")" = "$source_root" ]]
[[ "$(readlink -f "$destination")" = "$destination" ]]
exec 9>/run/lock/zynervoxv2-deploy.lock
flock -n 9 || { echo 'Ya existe un despliegue en curso.' >&2; exit 1; }
as_agent=(runuser -u codex-web -- env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/var/lib/codex-web-v4 GIT_CONFIG_GLOBAL=/var/lib/codex-web-v4/.gitconfig)
source_status="$("${as_agent[@]}" git -C "$source_root" status --porcelain)"
[[ -z "$source_status" ]] || { echo 'La fuente tiene cambios sin commit; no se despliega.' >&2; exit 1; }
commit="$("${as_agent[@]}" git -C "$source_root" rev-parse --verify HEAD)"
[[ "$commit" =~ ^[a-f0-9]{40,64}$ ]]
# Lista de AGI: se lee como DATO del commit que se publica (sin root, sin ejecutarla) y se valida.
agi_list="$("${as_agent[@]}" git -C "$source_root" show "$commit:installer/agi-list.txt")"
mapfile -t agi_paths < <(printf '%s\n' "$agi_list" | grep -vE '^[[:space:]]*(#|$)')
[[ ${#agi_paths[@]} -gt 0 ]] || { echo 'installer/agi-list.txt vacio o ausente en el commit.' >&2; exit 1; }
for agi_path in "${agi_paths[@]}"; do
  [[ "$agi_path" =~ ^[a-z0-9_]+/[a-z0-9_]+\.php$ ]] || { echo "Ruta de AGI invalida en agi-list.txt: $agi_path" >&2; exit 1; }
done
# Tanto Git como la extraccion corren sin root; nunca se ejecuta el instalador editable.
stage_parent=/run/zynervoxv2-deploy
[[ ! -L "$stage_parent" ]]
install -d -o root -g root -m 0711 "$stage_parent"
stage="$(mktemp -d "$stage_parent/stage.XXXXXXXX")"
cleanup() { [[ "$stage" = "$stage_parent"/stage.* ]] && rm -rf -- "$stage"; }
trap cleanup EXIT
chown codex-web:codex-web "$stage"
"${as_agent[@]}" git -C "$source_root" archive --format=tar "$commit:app/web" |
  "${as_agent[@]}" tar -xf - -C "$stage" --no-same-owner --no-same-permissions
chown root:root "$stage"
chmod 0700 "$stage"
chown -hR root:root "$stage"
find "$stage" -type f -exec chmod 0640 {} +
for agi in "${agi_paths[@]}"; do
  [[ ! -f "$stage/$agi" || -L "$stage/$agi" ]] || chmod 0750 "$stage/$agi"
done
options=(-rcpgo --no-links --no-specials --no-devices --chown=root:apache --chmod=D750 --itemize-changes
  --exclude=runtime/ --exclude=venvs/ --exclude=secrets/ --exclude=__pycache__/ '--exclude=*.pyc'
  '--exclude=*.bak*' --exclude=.env '--exclude=.env.*' '--exclude=*.pem' '--exclude=*.key'
  --exclude=/config/deployment.php --exclude=/config/reporting_mirror.json)
if [[ "$mode" = preview ]]; then
  options+=(--dry-run)
else
  backup_parent=/var/backups/zynervoxv2-web
  [[ ! -L "$backup_parent" ]]
  install -d -o root -g root -m 0700 "$backup_parent"
  backup="$(mktemp -d "$backup_parent/$(date +%Y%m%d-%H%M%S).XXXXXXXX")"
  options+=(--backup "--backup-dir=$backup")
fi
printf 'COMMIT=%s MODE=%s\n' "$commit" "$mode"
rsync "${options[@]}" -- "$stage/" "$destination/"
if [[ "$mode" = apply ]]; then
  for agi in "${agi_paths[@]}"; do
    [[ ! -f "$destination/$agi" || -L "$destination/$agi" ]] || chmod 0750 "$destination/$agi"
  done
  # rsync recrea los inodos sin -A y el arbol no tiene ACL por defecto: se restauran las ACL de asterisk y codex-web.
  find "$destination" \( -path "$destination/venvs" -o -path "$destination/runtime" \) -prune -o \
    -exec setfacl -m u:asterisk:rX,u:codex-web:rX {} +
  restorecon -R "$destination"
  printf 'BACKUP=%s\n' "$backup"
fi
